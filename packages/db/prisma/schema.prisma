// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Institutions ──────────────────────────────────────────────────────────────

model Institution {
  id              String   @id @default(cuid())
  name            String
  country         String
  website         String?
  logoUrl         String?
  did             String?  @unique // did:sol:<pubkey>
  walletAddress   String?  @unique // Solana wallet address
  merkleTree      String?  // Bubblegum Merkle tree address
  onboardingStep  Int      @default(0)
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  credentials     Credential[]

  @@map("institutions")
}

// ── Users (institution admins) ────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  role          UserRole    @default(ADMIN)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

// ── Students ──────────────────────────────────────────────────────────────────

model Student {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  studentId     String   // institution-specific student ID
  walletAddress String?  // Solana wallet address (linked later)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  credentials   Credential[]

  @@unique([email, studentId])
  @@map("students")
}

// ── Credentials ───────────────────────────────────────────────────────────────

model Credential {
  id             String           @id @default(cuid())
  mintAddress    String           @unique // Solana cNFT mint address
  vcJson         Json             // Full W3C VC payload
  ipfsCid        String?          // IPFS CID of the VC document
  status         CredentialStatus @default(ACTIVE)
  institutionId  String
  institution    Institution      @relation(fields: [institutionId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  issuedAt       DateTime         @default(now())
  revokedAt      DateTime?
  revocationNote String?

  @@map("credentials")
}

enum CredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ── Revocation audit log ──────────────────────────────────────────────────────

model RevocationLog {
  id           String   @id @default(cuid())
  mintAddress  String
  revokedBy    String   // User ID
  reason       String?
  txSignature  String?  // Solana tx signature
  createdAt    DateTime @default(now())

  @@map("revocation_logs")
}
