# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://credibly:credibly@localhost:5432/credibly_dev"
REDIS_URL="redis://localhost:6379"

# ── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET="change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# ── Solana ─────────────────────────────────────────────────────────────────────
SOLANA_NETWORK="localnet"                   # localnet | devnet | mainnet-beta
SOLANA_RPC_URL="http://127.0.0.1:8899"
INSTITUTION_KEYPAIR_PATH="~/.config/solana/id.json"

# Anchor program IDs (populated after: pnpm --filter @credibly/programs deploy:localnet)
DID_REGISTRY_PROGRAM_ID=""
REVOCATION_REGISTRY_PROGRAM_ID=""

# Metaplex Bubblegum Merkle tree (created on first-run setup)
MERKLE_TREE_ADDRESS=""

# ── IPFS (Pinata) ────────────────────────────────────────────────────────────
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud"

# ── Email (use Mailtrap for dev) ───────────────────────────────────────────────
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@credibly.app"

# ── Next.js public env vars (prefix with NEXT_PUBLIC_) ───────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOLANA_NETWORK="localnet"
NEXT_PUBLIC_SOLANA_RPC_URL="http://127.0.0.1:8899"

# ── App URLs ───────────────────────────────────────────────────────────────────
INSTITUTION_DASHBOARD_URL="http://localhost:3001"
VERIFIER_PORTAL_URL="http://localhost:3002"
LANDING_URL="http://localhost:3003"
API_URL="http://localhost:4000"
